// A manifest for testing zon2nix from end to end, in CI on every platform
// the flake supports. Between them the dependencies cover every way a
// package can arrive: an archive in each format Zig unpacks, one without a
// manifest of its own, a git repository, and a `.path` dependency with
// dependencies of its own. They are small, and none has dependencies of its
// own, so the run stays quick.
//
// One more, `excluded`, cannot be fetched at all. check.sh passes
// `--exclude excluded`, so the run fails if that stops leaving it out.
.{
    .name = .e2e,
    .version = "0.0.0",
    .fingerprint = 0x61f5117f5a0e2e01,
    .dependencies = .{
        // A zip archive.
        .uucode_zip = .{
            .url = "https://github.com/jacobsandlund/uucode/archive/9d55524551411b493cca41ca06363625d90aff1e.zip",
            .hash = "uucode-0.2.0-ZZjBPuuFVgC8YZ8eld4fOKsZANLIhTFMzULQxhkLi1C7",
        },
        // A git repository, which still goes through `zig fetch`.
        .uucode_git = .{
            .url = "git+https://github.com/jacobsandlund/uucode#2826a37a4562284fdacd8fa029d49509cc9bffcd",
            .hash = "uucode-0.2.0-ZZjBPlK5VADj7fdoq7G8LIHzD5o6FSkcBXXrRWr4jnrA",
        },
        // A git repository whose .gitattributes rewrites a file on checkout
        // -- examples/win32/build.bat gets CRLF line endings -- where Zig
        // reads the file as committed, with LF. It brings zig-datetime, also
        // from git, and, lazily, zigwin32, which is large and which check.sh
        // leaves out with --exclude.
        .fluent = .{
            .url = "git+https://git.jcollie.dev/jeff/zig-fluent.git#93101b427f76619d14cb8d433afc507fd3af0d02",
            .hash = "fluent-0.1.0-N_WW89PZcABO-GT7Whp6v-AHIGdyypS354Gzy660ujta",
        },
        // A .tar.gz.
        .known_folders = .{
            .url = "https://github.com/ziglibs/known-folders/archive/6da0d0c41b78b9ed2d34fa364fcb81b5ebece6c4.tar.gz",
            .hash = "known_folders-0.0.0-Fy-PJiDLAAB98m3uYUzatrTb2mO2fpvwx2zpSroEtfbO",
        },
        // A .tar.zst.
        .gobject = .{
            .url = "https://deps.files.ghostty.org/gobject-2026-07-28-36-1.tar.zst",
            .hash = "gobject-0.3.2-Skun7F6HogCMynX2JqeSHS7xr-8pK4ob-qRFIcEasVi3",
        },
        .local = .{
            .path = "local",
        },
        // Left out with --exclude: the name is reserved and never resolves.
        .excluded = .{
            .url = "https://example.invalid/excluded.tar.gz",
            .hash = "excluded-0.0.0-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
            .lazy = true,
        },
    },
    .paths = .{""},
}
